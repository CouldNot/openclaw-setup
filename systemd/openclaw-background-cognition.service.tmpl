[Unit]
Description=OpenClaw background cognition pass
After=openclaw-gateway.service

[Service]
Type=oneshot
Environment=HOME=__OPENCLAW_HOME__
Environment=PATH=__OPENCLAW_HOME__/.openclaw/tools/node-v24.15.0/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=__OPENCLAW_HOME__/.openclaw/workspace-personal
ExecStart=/usr/bin/python3 __OPENCLAW_HOME__/.openclaw/extensions/background-cognition/cognition_worker.py
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=360
